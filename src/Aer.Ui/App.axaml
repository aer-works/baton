<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Aer.Ui.Converters"
             x:Class="Aer.Ui.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- M25 (#345): generated from design/tokens.json, the source of truth shared with Flutter.
             The colour palette lives here now (#1065): the semantic Color.* brushes the views bind
             are emitted from these tokens, so the 0006 "Quiet" teal is the one applied palette. The
             two dictionaries no longer collide on any key — Tokens.axaml below was slimmed to the
             residual colours and scale the generated palette does not yet cover — so merge order is
             not load-bearing. Do not hand-edit; CI fails on drift. -->
        <ResourceInclude Source="/Theme/GeneratedTokens.axaml" />
        <!-- M19 Phase 2 (#187): the residual palette (no token twin yet) + the type/space/scale — see
             this file's own header for what stayed and why. Every surface consumes these by name. -->
        <ResourceInclude Source="/Theme/Tokens.axaml" />
        <!-- Post-M19 design review (#206): status icon geometries -->
        <ResourceInclude Source="/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:StatusToIconGeometryConverter x:Key="StatusToIconGeometryConverter" />
      <conv:StatusToIconBrushConverter x:Key="StatusToIconBrushConverter" />
      <conv:StatusToIconFillConverter x:Key="StatusToIconFillConverter" />
      <conv:VendorIconGeometryConverter x:Key="VendorIconGeometryConverter" />
      <conv:VendorIconBrushConverter x:Key="VendorIconBrushConverter" />
      <conv:VendorDisplayNameConverter x:Key="VendorDisplayNameConverter" />
      <conv:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Theme/Base.axaml" />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/aer.ico" ToolTipText="Baton">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Baton" Click="MenuShow_Click" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="MenuExit_Click" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
