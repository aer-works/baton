<!-- M24 Phase 1 desktop chat UI (issue #262): a dedicated view for interactive chat/codebase
     sessions instead of the generic Task view's DAG drill-in — a single repeatedly-superseded
     "chat" step has no dependency graph worth showing, and the real content
     (SessionMetadata.Turns) lives outside RoomProjection entirely (see ChatViewModel's remarks). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aer.Ui.Core;assembly=Aer.Ui.Core"
             xmlns:md="clr-namespace:Aer.Ui.Markdown"
             x:Class="Aer.Ui.Views.ChatView"
             x:DataType="vm:MainWindowViewModel">
  <DockPanel Margin="24">
    <!-- Daily-driver header (docs/design/02-screens.md): the room name, with the worker as a chip
         beside it ("aer-flow  claude") — not "vendor — turn N". "+ Add worker" and multi-worker
         chips are M27. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource Space.3}">
      <TextBlock Classes="display" Text="{Binding Chat.HeadlineText}" VerticalAlignment="Center" />
      <Border IsVisible="{Binding Chat.HasWorker}" VerticalAlignment="Center"
              Background="{DynamicResource Color.SurfaceSubtle}"
              BorderBrush="{DynamicResource Color.BorderSubtle}" BorderThickness="1"
              CornerRadius="20" Padding="10,2">
        <TextBlock Classes="caption" Text="{Binding Chat.WorkerChipText}" VerticalAlignment="Center" />
      </Border>
      <!-- Offered only for a workflow room: a chat session's single repeatedly-superseded step has
           no graph worth drawing (ChatViewModel's own remarks). What the panel holds and where it
           renders is on ChatViewModel.IsShapePanelOpen and MainWindow.ApplyShellLayout. -->
      <ToggleButton x:Name="ChatShapeToggle" VerticalAlignment="Center" Content="Shape"
                    IsVisible="{Binding Chat.IsPipelineRoom}"
                    IsChecked="{Binding Chat.IsShapePanelOpen}" />
      <!-- #1215: "Stop is always present and always distinct from a gate"
           (docs/design/03-interaction-depth.md). Slice 3 moved RoomView into the collapsible Shape
           panel and Stop went with it, so Stop existed only while a panel that is closed by default
           was open. Present-and-disabled rather than hidden is what "always present" means here:
           a person looking for the brake must find it in the same place whether or not anything is
           running. Enablement mirrors the binding it had in RoomView, unchanged. -->
      <Button x:Name="StopButton" VerticalAlignment="Center"
              IsEnabled="{Binding IsMutationInFlight}"
              ToolTip.Tip="Cancel every execution this window currently has in flight.">
        <AccessText Text="_Stop" />
      </Button>
    </StackPanel>

    <!-- Persistent mode indicator (#286): mode buttons live in the collapsed Commands panel below,
         but the currently active mode was previously invisible until you reopened that panel and
         happened to remember which button you last clicked. -->
    <TextBlock DockPanel.Dock="Top" Classes="caption secondary" Margin="0,2,0,0"
               Text="{Binding Chat.CurrentMode, StringFormat='Mode: {0}'}"
               IsVisible="{Binding Chat.HasCurrentMode}" />

    <TextBlock DockPanel.Dock="Top" Classes="secondary" Foreground="{DynamicResource Status.Failed}"
               TextWrapping="Wrap" Text="{Binding Chat.StatusText}"
               IsVisible="{Binding Chat.HasStatusText}" />

    <StackPanel DockPanel.Dock="Bottom" Spacing="{DynamicResource Space.2}" Margin="0,12,0,0">
      <!-- The raw in-turn stream — plain text for now (Kind-based rendering, e.g. distinguishing
           tool calls from prose, is visual polish left for M25). -->
      <Border Classes="card" IsVisible="{Binding Chat.IsSending}" MaxHeight="140">
        <ScrollViewer>
          <TextBlock Classes="mono caption" TextWrapping="Wrap" Text="{Binding Chat.LiveProgressText}" />
        </ScrollViewer>
      </Border>
      <!-- Chat capability picker (M24 Phase 2 follow-up): recently-used skills/commands/agents
           first, an informational-only section for modes/plugins that aren't chat-invokable, plus
           session-level mode buttons applying to whichever vendor is currently active. -->
      <Border Classes="card" IsVisible="{Binding Chat.IsCommandMenuOpen}" MaxHeight="220">
        <ScrollViewer>
          <StackPanel Spacing="{DynamicResource Space.2}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.1}">
              <TextBlock Classes="caption body-strong" Text="Mode" VerticalAlignment="Center" />
              <Button x:Name="ChatModeAutoButton" Content="Auto" />
              <Button x:Name="ChatModeDefaultButton" Content="Default" />
              <Button x:Name="ChatModePlanButton" Content="Plan (read-only)" />
            </StackPanel>
            <ItemsControl x:Name="ChatCommandsList" ItemsSource="{Binding Chat.InvokableCommands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatCapabilityItemViewModel">
                  <Button Classes="ghost" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.1}">
                      <TextBlock Classes="body-strong" Text="{Binding Name}" />
                      <TextBlock Classes="caption secondary" Text="{Binding Description}" />
                      <TextBlock Classes="caption" Text="recent" IsVisible="{Binding IsRecentlyUsed}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Chat.InfoCommands}" IsVisible="{Binding Chat.InfoCommands.Count}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatCapabilityItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.1}">
                    <TextBlock Classes="caption secondary" Text="{Binding Name}" />
                    <TextBlock Classes="caption secondary" Text="{Binding Description}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <!-- The sentence beside the disabled composer. Why it is disabled rather than removed is on
           ChatViewModel.IsComposerVisible, which cites the design record that settled it. -->
      <TextBlock Classes="caption secondary" TextWrapping="Wrap" Margin="0,0,0,4"
                 IsVisible="{Binding Chat.IsPipelineRoom}"
                 Text="This room's workers aren't conversational yet — you can answer its decisions here, but not talk to it." />
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}"
                  IsVisible="{Binding Chat.IsComposerVisible}">
        <!-- AcceptsReturn stays true so Shift+Enter inserts a newline; a bare Enter is intercepted by
             MainWindow's OnChatInputBoxKeyDown and sends instead. -->
        <!-- #1074 (slice of #462): the composer never disables while a turn is in flight — a send
             then queues (below) instead of posting a concurrent turn. "A busy anything is never a
             reason you cannot act" (02-screens.md). IsComposerEnabled is a different question:
             whether this room can be talked to at all, which a pipeline room cannot. -->
        <TextBox x:Name="ChatInputBox" Width="600" AcceptsReturn="True" MaxHeight="80"
                 Text="{Binding Chat.InputText}"
                 IsEnabled="{Binding Chat.IsComposerEnabled}"
                 PlaceholderText="Reply…" />
        <Button x:Name="ChatSendButton" Classes="accent" Content="Send"
                IsEnabled="{Binding Chat.IsComposerEnabled}" />
        <Button x:Name="ChatCommandsButton" Content="Commands"
                IsEnabled="{Binding Chat.IsComposerEnabled}" />
        <ProgressBar IsIndeterminate="True" Width="20" Height="20" VerticalAlignment="Center"
                     IsVisible="{Binding Chat.IsSending}" />
      </StackPanel>

      <!-- #1074: messages typed during an in-flight turn wait here and send when it frees — visible
           and removable, per the design's "the queue … says what it is waiting for". Kept visually
           plain on purpose; rich message rendering is #267. -->
      <StackPanel IsVisible="{Binding Chat.HasQueuedMessages}" Spacing="{DynamicResource Space.1}"
                  Margin="0,4,0,0">
        <TextBlock Classes="caption secondary" Text="Queued — sends when the reply finishes." />
        <ItemsControl ItemsSource="{Binding Chat.QueuedMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QueuedChatMessageViewModel">
              <Border Classes="card you" Margin="0,0,0,4">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Remove" VerticalAlignment="Center"
                          Command="{Binding RemoveCommand}" />
                  <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Text}"
                             VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- "Start new chat" entry point (#290): no dependency on the template picker, which forced
           picking through five unrelated template kinds (review-run, solo-run, ...) just to start a
           plain chat. Working directory is optional — omitting it starts a plain chat session, same
           as the template picker's own "chat session" option with no project directory set. -->
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}"
                  IsVisible="{Binding Chat.IsNewChatVisible}">
        <!-- #981: OneWay, deliberately. Two-way SelectedItem let the control write its own
             cleared selection (from every ItemsSource Clear/refill) back into NewChatAdapter,
             after which each re-assert pushed null and the combo rendered blank while the
             ViewModel looked healthy under headless assertions. Upward travel happens only
             through a real pick — ChatView's SelectionChanged handler. -->
        <ComboBox x:Name="ChatNewAdapterCombo" Width="140"
                  ItemsSource="{Binding Chat.AvailableAdapters}"
                  SelectedItem="{Binding Chat.NewChatAdapter, Mode=OneWay}"
                  IsEnabled="{Binding !Chat.IsStartingNewChat}" />
        <TextBox x:Name="ChatNewWorkingDirectoryBox" Width="360"
                 Text="{Binding Chat.NewChatWorkingDirectory}"
                 IsEnabled="{Binding !Chat.IsStartingNewChat}"
                 PlaceholderText="Working directory (optional — plain chat if empty)" />
        <Button x:Name="ChatStartNewButton" Classes="accent" Content="Start new chat"
                IsEnabled="{Binding !Chat.IsStartingNewChat}" />
        <ProgressBar IsIndeterminate="True" Width="20" Height="20" VerticalAlignment="Center"
                     IsVisible="{Binding Chat.IsStartingNewChat}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer x:Name="ChatMessagesScroll">
      <StackPanel>
        <ItemsControl x:Name="ChatMessagesList" ItemsSource="{Binding Chat.Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Border Classes="card" Classes.you="{Binding IsFromUser}" Classes.system="{Binding IsSystem}" Classes.failure="{Binding IsFailure}" Classes.dormancy="{Binding IsDormancy}" Classes.outofplan="{Binding IsOutOfPlan}" Margin="0,0,0,8">
                <StackPanel Spacing="{DynamicResource Space.1}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.1}">
                    <TextBlock Text="⏾" Classes="caption who" IsVisible="{Binding IsDormancy}" />
                    <TextBlock Classes="caption who" Text="{Binding SenderLabel}" />
                  </StackPanel>
                  <md:MarkdownPresenter Markdown="{Binding Text}" />
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}" IsVisible="{Binding IsFailure}">
                    <Button Content="{Binding SenderLabel, StringFormat='Ask {0} to fix'}" Command="{Binding PrepareFixPromptCommand}" />
                    <Button Content="Copy" Click="OnCopyFailureClick" />
                  </StackPanel>
                  <!-- 0026 §4/#1180: Copy only, deliberately no fix-ask affordance; rationale on
                       ChatMessageViewModel.IsOutOfPlan (Aer.Ui.Core/ChatViewModel.cs). -->
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}" IsVisible="{Binding IsOutOfPlan}">
                    <Button Content="Copy" Click="OnCopyFailureClick" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}" IsVisible="{Binding IsDormancy}">
                    <Button Content="Wake" Command="{Binding WakeCommand}" IsVisible="{Binding WakeCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The conversational permission gate (0022, #390, #1173): rendered as the last item in the
             transcript scroll region, directly following the messages. The scope ladder stays VISIBLE here
             rather than buried in settings — the middle rungs are "what make it survivable". The cross-room
             rung is deliberately absent (0052: held until a project-scoped store exists). y answers
             "Allow once", n answers "Deny once"; neither is ever bound to Enter (0022 §4, #481) — see
             MainWindow.PermissionAnswerFor. -->
        <Border x:Name="ChatPermissionGate" Classes="card" IsVisible="{Binding Chat.HasPendingPermission}"
                BorderBrush="{DynamicResource Status.Failed}" BorderThickness="1">
          <StackPanel DataContext="{Binding Chat.PendingPermission}" x:DataType="vm:PendingPermissionViewModel"
                      Spacing="{DynamicResource Space.2}">
            <TextBlock Classes="body-strong" TextWrapping="Wrap" Text="{Binding PromptText}" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
              <Button x:Name="ChatPermissionAllowOnceButton" Content="Allow once" Command="{Binding AllowOnceCommand}" />
              <Button Content="Deny once" Command="{Binding DenyCommand}" />
              <TextBlock Classes="caption secondary" VerticalAlignment="Center"
                         Text="press y to allow · n to deny" />
            </StackPanel>
            <TextBlock Classes="caption secondary" Text="Scope this decision:" />
            <StackPanel Spacing="{DynamicResource Space.1}">
              <Button Classes="ghost" HorizontalAlignment="Left" IsVisible="{Binding HasCommandScope}"
                      Content="{Binding AllowCommandInRoomLabel}" Command="{Binding AllowCommandInRoomCommand}" />
              <Button Classes="ghost" HorizontalAlignment="Left"
                      Content="Allow any command in this room" Command="{Binding AllowRoomCommand}" />
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding AllowRoomDisclosure}" />
              <Button Classes="ghost" HorizontalAlignment="Left" IsVisible="{Binding HasCommandScope}"
                      Content="{Binding DenyAlwaysLabel}" Command="{Binding DenyAlwaysCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- #1196 slice 3: the room's open decisions, moved here from RoomView unchanged — same
             template, same commands, same feedback-file row. A position move is the shipped
             convention of this family (#1145/#1174/#1177/#1181/#1185), and it is a MOVE rather than a
             copy on purpose: two places to answer the same decision would be two decision surfaces,
             which is the thing this slice exists to end.
             Needs-you first: the review gate's inline decisions, in plain words, before anything
             read-only. Same M15 commands, same semantics — Approve is Resume, Send back is
             Supersede (feedback file mandatory), Retry is RetryWithRevision (§17). -->
        <ItemsControl x:Name="PausedStepsList" ItemsSource="{Binding Chat.PendingDecisions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PausedStepViewModel">
              <Border Classes="card needs-you" Margin="0,0,0,8">
                <StackPanel Spacing="{DynamicResource Space.3}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
                    <Path Data="{StaticResource Icon.Dot}" Fill="{DynamicResource Status.NeedsInput}"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Classes="heading" Text="{Binding StepId, StringFormat='Waiting for your review — {0}'}" />
                  </StackPanel>
                  <TextBlock Classes="caption" Text="{Binding Label}" />
                  <!-- Wraps rather than clips (#1204). The transcript column narrows when the Shape
                       panel opens beside it, and the horizontal StackPanel this replaces cut "Send
                       back" and the supplementary fields off the right edge — found by driving the
                       built app, invisible to every headless test, which measures no width. -->
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <!-- #218: Approve/Retry/Reject reuse the status check/refresh/cross glyphs
                         already established (#206) — same shapes, same meaning, no new vocabulary. -->
                    <Button Classes="accent" Command="{Binding ApproveCommand}"
                            ToolTip.Tip="Accept this step's output and let the workflow continue.">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
                        <Path Classes="action-icon" Data="{StaticResource Icon.Check}"
                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <AccessText Text="A_pprove" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding RetryCommand}"
                            ToolTip.Tip="Run this step again, optionally with your feedback file attached.">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
                        <Path Classes="action-icon" Data="{StaticResource Icon.Refresh}"
                              StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <AccessText Text="_Retry this step" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding RejectCommand}"
                            ToolTip.Tip="End this step here — the workflow does not continue past it.">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
                        <Path Classes="action-icon" Data="{StaticResource Icon.Cross}"
                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <AccessText Text="Re_ject" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding SendBackTargets}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SendBackTargetViewModel">
                          <Button Content="{Binding Label}" Command="{Binding SendBackCommand}"
                                  ToolTip.Tip="Send the work back to an earlier step, with your feedback file — the feedback is what that step revises against." />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </WrapPanel>
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <TextBlock Text="Feedback file:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RevisionFilePath}" Width="260"
                             PlaceholderText="Optional for Retry, required to send back" />
                    <Button Content="Choose file…" Click="OnChooseFeedbackFileClick" />
                    <TextBlock Text="Worker:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SupplementaryWorker}" Width="110" />
                    <TextBlock Text="Output:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SupplementaryOutputName}" Width="110" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="DecisionStatusText" Text="{Binding DecisionStatusText}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

