<!-- Settings (#1068, docs/design/02-screens.md:253-285): "Three groups, one screen, no tabs" —
     Workers, Your phone, Appearance. This is the former Remote nav destination, now the Settings
     surface that folds pairing in (RemoteView is embedded under "Your phone"). Density is a
     deliberate deferral (design-open on desktop); Theme is the group's live control here. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aer.Ui.Core;assembly=Aer.Ui.Core"
             xmlns:views="clr-namespace:Aer.Ui.Views"
             x:Class="Aer.Ui.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="{DynamicResource Space.8}" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="display" Text="Settings" />

      <!-- Workers: the same vendor-readiness the first-run screen shows (#478), in the place you'd
           go looking for it later. Reuses NewWorkflow.VendorReadinessLines — one source, two
           contexts (02-screens). -->
      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="heading" Text="Workers" />
        <ItemsControl ItemsSource="{Binding NewWorkflow.VendorReadinessLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="secondary" Text="{Binding}" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                   Text="Baton runs whichever CLI is already signed in on this machine. It never stores keys." />

        <!-- #1298: the concurrency caps ConcurrencySlotGate enforces (#1296 already shows the
             WaitingToStart card when a room is queued behind them), adjustable here, applied
             immediately and persisted to ~/.aer/settings.json. -->
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
          <TextBlock Classes="secondary" VerticalAlignment="Center" MinWidth="140" Text="Max at once, overall" />
          <TextBox x:Name="ConcurrencyGlobalCapTextBox" Width="60" Text="{Binding Concurrency.GlobalCapText}" />
          <TextBlock Classes="secondary" VerticalAlignment="Center" MinWidth="140" Margin="16,0,0,0" Text="Max at once, per worker" />
          <TextBox x:Name="ConcurrencyPerVendorCapTextBox" Width="60" Text="{Binding Concurrency.PerVendorCapText}" />
          <Button x:Name="ConcurrencySaveButton" Content="Save" IsEnabled="{Binding Concurrency.CanSave}" />
        </StackPanel>
        <TextBlock Classes="caption" Foreground="{DynamicResource Status.Failed}" TextWrapping="Wrap"
                   IsVisible="{Binding Concurrency.HasError}" Text="{Binding Concurrency.ErrorText}" />
      </StackPanel>

      <!-- Your phone: the folded-in Remote surface (#338). RemoteView is now an embeddable content
           block; this group supplies its heading. -->
      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="heading" Text="Your phone" />
        <views:RemoteView x:Name="RemoteViewControl" />
      </StackPanel>

      <!-- Appearance: Theme now, Density deferred (#1068). The active choice shows as the accent
           button; System means "follow the OS", the app's behaviour before this control existed. -->
      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="heading" Text="Appearance" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
          <TextBlock Classes="secondary" VerticalAlignment="Center" MinWidth="80" Text="Theme" />
          <Button x:Name="ThemeLightButton" Content="Light" Classes.accent="{Binding IsThemeLight}" />
          <Button x:Name="ThemeDarkButton" Content="Dark" Classes.accent="{Binding IsThemeDark}" />
          <Button x:Name="ThemeSystemButton" Content="System" Classes.accent="{Binding IsThemeSystem}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
