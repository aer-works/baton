<!-- M19 Phase 3 (#188): the Task view rebuilt human-first — needs-you first (inline decisions),
     then the DAG as the primary surface with per-step drill-in tabs (attempts / outputs /
     conversation / decisions), plain-language vocabulary throughout the primary text. The precise,
     complete engine-level record stays one disclosure away in the Details expander (§12
     traceability; ux-principles' progressive disclosure). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aer.Ui.Core;assembly=Aer.Ui.Core"
             xmlns:controls="clr-namespace:Aer.Ui.Controls"
             x:Class="Aer.Ui.Views.RoomView"
             x:DataType="vm:MainWindowViewModel">
  <!-- #1204's horizontal scroller is gone with what overflowed. It existed because this view's
       fixed-width header path boxes ran off the edge at the Shape panel's ~460px; #1215 retired the
       header, and what remains sizes to the panel — the DAG carries its own scroller and the step
       chips wrap. -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
      <TextBlock Classes="display" Text="{Binding RoomHeadlineText}" />
      <!-- The empty state says what to do next (Phase 5): nothing open, two ways forward. -->
      <TextBlock Classes="secondary" IsVisible="{Binding !HasSelectedStep}" TextWrapping="Wrap"
                 Text="Open a room from Home, or create and run a workflow in Author — this view fills in as soon as a room is open." />

      <!-- #1215 emptied this header. The path boxes became view-model state — why, and what still
           reads them, is on MainWindowViewModel.WorkflowTemplateFilePath. Stop moved to the room
           header in ChatView; Run is retired in favour of RoomStoppedCardViewModel's offer on the
           transcript. What is left of this view is the room's shape. -->
      <TextBlock x:Name="RunStatusText" Text="{Binding RunStatusText}"
                 IsVisible="{Binding RunStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- #1299 (#480): waiting-on-lock banner — RoomCardStatus.WaitingOnLock's own quiet mark/color
           (0006/quiet: a wait, never an error), not NeedsInput's -->
      <Border Classes="card" IsVisible="{Binding HasWaitingOnLockBanner}" Background="{DynamicResource Color.SurfaceSubtle}" Margin="0,4,0,4">
        <StackPanel Spacing="8" DataContext="{Binding WaitingOnLockBanner}" x:DataType="vm:WaitingOnLockBannerViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource Icon.Lock}" Stroke="{DynamicResource Status.WaitingOnLock}"
                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Classes="heading" Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="body" Text="{Binding HolderText}" TextWrapping="Wrap" />
          <Button Command="{Binding TryAgainCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="{StaticResource Icon.Refresh}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="Try again" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- #994: room throttle surface (values, live usage) -->
      <Border Classes="card" IsVisible="{Binding HasRoomTurnHostBanner}" Background="{DynamicResource Color.SurfaceSubtle}" Margin="0,4,0,4">
        <StackPanel Spacing="4" DataContext="{Binding RoomTurnHostBanner}" x:DataType="vm:RoomTurnHostBannerViewModel">
          <TextBlock Classes="body-strong" Text="{Binding MeterText}" />
          <TextBlock Classes="secondary" Text="{Binding ValuesText}" />
          <TextBlock x:Name="TurnHostMeterLoadError" Classes="secondary" Text="{Binding LoadErrorText}" IsVisible="{Binding LoadErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>


      <!-- The DAG, primary: click a node to open that step's drill-in. A bordered, dot-gridded
           canvas region (n8n/Dagster's convention, per design-language.md's reference set) gives
           the graph a defined surface instead of nodes floating loose on the page background. -->
      <Border BorderBrush="{DynamicResource Color.BorderSubtle}" BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Medium}" ClipToBounds="True">
        <Panel Background="{DynamicResource Color.Surface}">
          <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
              <DrawingBrush TileMode="Tile" Stretch="None" DestinationRect="0,0,16,16" SourceRect="0,0,16,16">
                <DrawingBrush.Drawing>
                  <GeometryDrawing Brush="{DynamicResource Color.BorderSubtle}">
                    <GeometryDrawing.Geometry>
                      <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Rectangle.Fill>
          </Rectangle>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="200" MaxHeight="360">
            <!-- Space.4 (16px) inlined for Margin — DynamicResource can't cross double->Thickness. -->
            <Canvas x:Name="DagCanvas" Margin="16" />
          </ScrollViewer>
        </Panel>
      </Border>

      <ItemsControl x:Name="StepChipsList" ItemsSource="{Binding RoomSteps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StepItemViewModel">
            <Button Classes="card" Classes.selected="{Binding IsSelected}" Margin="0,0,8,8"
                    Command="{Binding SelectCommand}">
              <StackPanel Spacing="{DynamicResource Space.1}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
                  <Path Data="{Binding Status, Converter={StaticResource StatusToIconGeometryConverter}}"
                        Stroke="{Binding Status, Converter={StaticResource StatusToIconBrushConverter}}"
                        Fill="{Binding Status, Converter={StaticResource StatusToIconFillConverter}}"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Classes="body-strong" Text="{Binding StepId}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Data="{Binding VendorKey, Converter={StaticResource VendorIconGeometryConverter}}"
                        Fill="{Binding VendorKey, Converter={StaticResource VendorIconBrushConverter}}"
                        Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Classes="caption" Text="{Binding VendorDisplay}" VerticalAlignment="Center" />
                  <!-- #1318/#1339 (decision 0058's scope ruling): depth and effort as marks beside
                       the vendor word — vendor stays text (constraint 4), depth/effort become marks.
                       DepthTier renders for a claude worker on a recorded model alias; an agy worker
                       (or an unrecognized model) resolves to null, and the control renders nothing
                       for it, which is expected (ruling 2), not a missing binding. 16, not 11: the
                       geometry is authored on a 16-unit grid with a 3-unit smallest feature
                       (Icons.axaml's Icon.EffortStep*), and the status mark beside it already gets
                       12 (below) — 11 left no room for a step to read as anything but a smear. -->
                  <controls:TierMeter Steps="{Binding DepthTier, Converter={StaticResource DepthTierMeterStepsConverter}}"
                                       Width="16" Height="16" VerticalAlignment="Center" />
                  <controls:TierMeter Steps="{Binding EffortTier, Converter={StaticResource EffortTierMeterStepsConverter}}"
                                       Width="16" Height="16" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The per-step drill-in: everything that used to sprawl as stacked sections, sliced to
           the selected step. -->
      <Border Classes="card" IsVisible="{Binding HasSelectedStep}">
        <StackPanel Spacing="8" DataContext="{Binding SelectedStep}" x:DataType="vm:StepItemViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="heading" Text="{Binding StepId}" />
            <TextBlock Classes="secondary" Text="{Binding PlainStatusText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Path Data="{Binding VendorKey, Converter={StaticResource VendorIconGeometryConverter}}"
                    Fill="{Binding VendorKey, Converter={StaticResource VendorIconBrushConverter}}"
                    Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Classes="caption" Text="{Binding VendorDisplay, StringFormat='runner: {0}'}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <!-- #617: failed-step banner (0020 clause 4: errors are content) -->
          <Border Classes="card" IsVisible="{Binding HasFailedBanner}" Background="{DynamicResource Color.SurfaceSubtle}" Margin="0,4,0,4">
            <StackPanel Spacing="8" DataContext="{Binding FailedBanner}" x:DataType="vm:FailedStepBannerViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource Icon.Cross}" Stroke="{DynamicResource Status.Failed}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Classes="body-strong" Text="{Binding Headline}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
              <Border IsVisible="{Binding HasStderrExcerpt}" Background="{DynamicResource Color.Background}" Padding="8" CornerRadius="4">
                <TextBlock Text="{Binding StderrExcerpt}" Classes="mono" TextWrapping="Wrap" MaxHeight="120" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Hidden, not disabled, while the task is unfinished: re-run-as-clone exists only
                     for a Terminal task, and a click that silently no-ops is worse than no button. -->
                <Button Command="{Binding TryAgainCommand}" IsVisible="{Binding CanTryAgain}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Data="{StaticResource Icon.Refresh}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TryAgainLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding AskWorkerToFixCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding AskWorkerLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding ShowFullOutputCommand}" IsEnabled="{Binding CanShowFullOutput}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Show full output" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <TabControl x:Name="StepDetailTabControl">
            <TabItem Header="Outputs">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Classes="secondary" Text="Nothing produced yet." IsVisible="{Binding !HasOutputFiles}" />
                <ItemsControl ItemsSource="{Binding OutputFiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtifactFileViewModel">
                      <Button Content="{Binding Label}" Command="{Binding PreviewCommand}"
                              Classes="chip" Classes.selected="{Binding IsSelected}" Margin="0,0,4,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- #292: an ordinary step's durably-captured resolved prompt — parity with dialogue's
                     collapsed-by-default "Prompt" expander (MainWindow.axaml.cs's RenderTurn), reusing
                     the same output-file chip + shared preview box rather than a bespoke surface. Only
                     present when a prompt was actually captured (adapters with nothing to capture, or
                     a task predating this feature, simply have none). -->
                <Expander Header="Prompt" IsExpanded="False" IsVisible="{Binding HasPromptFiles}">
                  <ItemsControl ItemsSource="{Binding PromptFiles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ArtifactFileViewModel">
                        <Button Content="{Binding Label}" Command="{Binding PreviewCommand}"
                                Classes="chip" Classes.selected="{Binding IsSelected}" Margin="0,0,4,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
                <TextBox x:Name="ArtifactPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="140" Classes="mono" />
              </StackPanel>
            </TabItem>
            <TabItem Header="Attempts">
              <!-- #597: an attempt line now carries the failure reason, so it can run long. Without
                   an item template these render through the default one as non-wrapping TextBlocks
                   and the tail is lost — on the plain-language surface a non-expert actually reads,
                   which matters more than the raw record panel that already wraps. -->
              <ItemsControl x:Name="AttemptsList" ItemsSource="{Binding AttemptLines}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </TabItem>
            <TabItem Header="Conversation">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Classes="secondary" Text="No conversation recorded for this step." IsVisible="{Binding !HasConversations}" />
                <ItemsControl ItemsSource="{Binding Conversations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversationRefViewModel">
                      <Button Content="{Binding Label}" Command="{Binding ShowCommand}" Margin="0,0,4,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="ConversationPanel" Spacing="6" />
              </StackPanel>
            </TabItem>
            <TabItem Header="Decisions">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Classes="secondary" Text="No decisions recorded for this step." IsVisible="{Binding !HasDecisions}" />
                <ItemsControl x:Name="StepDecisionsList" ItemsSource="{Binding DecisionLines}" />
              </StackPanel>
            </TabItem>
          </TabControl>
        </StackPanel>
      </Border>

      <!-- Owner feedback: this rendered its heading with nothing underneath whenever nothing was
           actually running — hidden entirely rather than shown as an unexplained blank panel. -->
      <StackPanel Spacing="12" IsVisible="{Binding HasRunningExecutions}">
        <TextBlock Classes="heading" Text="Working right now — stop a single attempt:" />
        <ItemsControl x:Name="RunningExecutionsList" ItemsSource="{Binding RunningExecutions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RunningExecutionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Label}" Width="280" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <TextBlock Text="cancellation requested…" IsVisible="{Binding CancellationRequested}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="CancelStatusText" Text="{Binding CancelStatusText}" />
      </StackPanel>

      <!-- §12 traceability: the full, precise engine-level record — every fact the drill-in
           re-slices, in spec vocabulary, one disclosure away. Wrapped in a card (rather than
           templating Expander's own chrome, which has no BoxShadow property to target) so this
           gets the same elevation treatment as every other surface. Padding="0" (#220): Expander's
           own template already pads its content — the card's default 16px on top of that was
           double-padding the one surface in the view that's already the most content-dense. -->
      <Border Classes="card" Padding="0">
      <Expander Header="Details — the full record" IsExpanded="False">
        <!-- Space.3 (12px) — Thickness can't consume DynamicResource (see the card Padding
             comments elsewhere), so this stays inlined, but on the grid, not an arbitrary value. -->
        <StackPanel Spacing="{DynamicResource Space.3}" Margin="0,8,0,0">
          <TextBlock x:Name="StatusText" FontWeight="Bold" Text="No room directory loaded." />
          <StackPanel x:Name="StepsPanel" Spacing="{DynamicResource Space.1}" />

          <TextBlock Classes="heading" Text="Execution history:" />
          <StackPanel x:Name="HistoryPanel" Spacing="{DynamicResource Space.1}" />

          <TextBlock Classes="heading" Text="Conversation (executions with a durable transcript):" />
          <StackPanel x:Name="ConversationExecutionsPanel" Spacing="{DynamicResource Space.1}" />

          <TextBlock Classes="heading" Text="Recorded decisions:" />
          <StackPanel x:Name="DecisionsPanel" Spacing="{DynamicResource Space.1}" />

          <!-- #213: plain-language renames per docs/archive/ux/ux-principles.md's vocabulary map — these
               stay one disclosure away (this Expander), so the precise spec terms survive in the
               tooltips/ids next to each entry, per the map's own "survives in disclosure
               surfaces" rule; only the section headers themselves needed to change. -->
          <TextBlock Classes="heading" Text="Extra runs — revised attempts and manually-supplied results:" />
          <StackPanel x:Name="SupplementaryPanel" Spacing="{DynamicResource Space.1}" />

          <TextBlock Classes="heading" Text="Output history — earlier versions of each file:" />
          <StackPanel x:Name="LineagePanel" Spacing="{DynamicResource Space.2}" />

          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
            <TextBlock Text="Compare against:" VerticalAlignment="Center" />
            <TextBox x:Name="TemplateComparePathBox" Width="480" PlaceholderText="(optional)" />
            <Button x:Name="CompareButton" Content="Compare to a workflow file" />
          </StackPanel>
          <TextBlock Classes="heading" Text="Changes vs. that workflow file:" />
          <StackPanel x:Name="DiffPanel" Spacing="{DynamicResource Space.1}" />
        </StackPanel>
      </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

