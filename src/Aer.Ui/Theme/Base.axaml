<!-- M19 Phase 2 (#187) grew this as the "nothing ships default-themed" floor; Phase 5 (#190)
     makes it the custom control theme over FluentTheme: every stock control re-skinned to the
     token system (design-language.md), with motion as short brush transitions — confirm, don't
     perform. Everything here consumes Tokens.axaml by name; a raw value is a defect. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Color.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
  </Style>

  <!-- Text roles -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource Type.Display.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource Type.Heading.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource Type.Caption.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
  </Style>

  <!-- Emphasis within body text — step names, card titles, labels. Distinct from heading's larger
       size and SemiBold; everything doing emphasis was using heading's weight ad hoc before this,
       which is why text read as uniformly flat regardless of its actual role. -->
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontSize" Value="{DynamicResource Type.BodyStrong.FontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
  </Style>

  <!-- FontMono is generated from design/tokens.json (#456), replacing this file's former
       "Cascadia Mono,Consolas,Menlo,monospace" chain. That chain resolved to a different face on
       every OS, which is precisely the per-device resolution decision 0006 rules out; the shipped
       JetBrains Mono renders the same everywhere. -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Type.Mono.FontSize}" />
  </Style>

  <!-- Stock controls, re-skinned to the tokens (Phase 5). Property-level restyling over
       FluentTheme's templates — the shapes are fine, the identity comes from color/radius. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- Radius.Medium, not .Small: the owner's "round buttons more" feedback — reuses the same
         two-radii budget the cards already sit on rather than inventing a third radius. -->
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
    <Setter Property="Padding" Value="14,7" />
    <!-- #214: every clickable control is a Button (cards, nav, chips included) — one setter here
         covers all of them, no per-class duplication needed. -->
    <Setter Property="Cursor" Value="Hand" />
    <!-- Owner feedback: nav rail hover/selection "flashed" — Foreground is set directly on Button
         (not the ContentPresenter the Background/BorderBrush Transitions below cover), so any
         Foreground change snapped instantly with no fade. Same BrushTransition treatment. -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.AccentPressed}" />
  </Style>

  <!-- The one loud button per surface: Run / Save and run / Approve. FluentTheme reserves the
       class name "accent" on Button for its own SystemAccentColor-based styling (issue #209 —
       the OS accent color, not Color.Accent, was winning) — setting Background/BorderBrush on
       Button itself lets that built-in styling win depending on theme variant. Targeting the
       template's ContentPresenter directly (the same mechanism the pointerover/pressed states
       below already use) forces Color.Accent to win unconditionally. -->
  <!-- Foreground is Color.OnAccent, not a fixed White: the Quiet accent is a dusty teal whose dark
       variant (#5FB3AD) is light enough that white label text falls below the contrast floor. The
       token carries the readable pairing per variant (white on the light-mode teal, near-black on
       the lighter dark-mode teal), so the label follows the accent instead of assuming it stays dark
       enough for white. -->
  <Style Selector="Button.accent">
    <Setter Property="Foreground" Value="{DynamicResource Color.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.OnAccent}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.AccentPressed}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
  </Style>

  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Type.Mono.FontSize}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A card: the surface unit Home's task cards and inbox items are built from. SurfaceRaised +
       Elevation.Raised (not the page's own Color.Surface) is what makes a card read as a distinct,
       lifted object rather than a flat-colored rectangle sitting on the same plane as the page. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
    <!-- Space.4 (16px) — Thickness properties can't consume the double-typed Space.* tokens
         through DynamicResource (no implicit conversion at runtime; throws InvalidCastException),
         so the value is inlined here instead of tokenized. -->
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation.Raised}" />
  </Style>

  <!-- The attention card: Status.NeedsInput is the loudest thing in the system (ux-principles §4) —
       Elevation.Overlay gives it more lift than an ordinary card, on top of its border/fill. -->
  <Style Selector="Border.card.needs-you">
    <Setter Property="BorderBrush" Value="{DynamicResource Status.NeedsInput}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="{DynamicResource Status.NeedsInputBg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation.Overlay}" />
  </Style>

  <!-- A clickable card (Home's task cards, the step chips). BoxShadow lives on Button, not
       Border, so it targets the template's ContentPresenter, same as the hover/pressed setters
       below already do for Background/BorderBrush. -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
    <!-- Space.4 (16px) — Thickness properties can't consume the double-typed Space.* tokens
         through DynamicResource (no implicit conversion at runtime; throws InvalidCastException),
         so the value is inlined here instead of tokenized. -->
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Button.card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation.Raised}" />
  </Style>
  <Style Selector="Button.card.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
  </Style>

  <!-- Transcript turns (docs/design/02-screens.md:70-80, mockup '.turn'/'.turn.you'): a worker's
       turn is an ordinary card with an accent sender label; your own turn is recessed and
       borderless with a muted label, so who-said-what reads at a glance without reading the words. -->
  <Style Selector="Border.card TextBlock.who">
    <Setter Property="Foreground" Value="{DynamicResource Color.Accent}" />
  </Style>
  <Style Selector="Border.card.you">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceSubtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="Border.card.you TextBlock.who">
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
  </Style>

  <!-- The navigation rail (#1071): icon-only bordered squares, per docs/design/mockups/02-screens.html's
       .rail styling — a 29x29 icon in a 1px rule border, radius 6, quiet by default (rule border,
       secondary glyph). The active destination alone takes the accent border, accent glyph, and the
       recessed "sunk" fill (Color.SurfaceSubtle). Icon-only means the label mnemonics give way to
       ToolTip.Tip + tab order (each rail Button carries a tooltip in MainWindow.axaml). -->
  <Style Selector="Button.nav">
    <Setter Property="Width" Value="29" />
    <Setter Property="Height" Value="29" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.Accent}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Color.Accent}" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
  </Style>

  <!-- #218: nav icons track the same Foreground the nav button's own text uses — Path.Stroke
       doesn't inherit Foreground the way TextBlock does, so this mirrors Button.nav/.selected's
       Foreground setters above explicitly, keyed off the same classes. The Transitions setter
       (owner feedback: the previously-selected item's icon "flashed" on switch) matches the same
       BrushTransition every other Stroke/Background color change in this file already has —
       without it, only the surrounding text/background faded while the icon snapped instantly. -->
  <Style Selector="Path.nav-icon, Path.action-icon, Path.titlebar-icon">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav Path.nav-icon">
    <Setter Property="Stroke" Value="{DynamicResource Color.TextSecondary}" />
  </Style>
  <Style Selector="Button.nav.selected Path.nav-icon">
    <Setter Property="Stroke" Value="{DynamicResource Color.Accent}" />
  </Style>

  <!-- #218: action-button icons (Approve/Retry/Reject/Browse) — same reasoning as nav-icon above. -->
  <Style Selector="Button Path.action-icon">
    <Setter Property="Stroke" Value="{DynamicResource Color.Text}" />
  </Style>
  <Style Selector="Button.accent Path.action-icon">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="Button.titlebar-button">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.titlebar-button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBgTransparent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.titlebar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.titlebar-button:pointerover Path.titlebar-icon">
    <Setter Property="Stroke" Value="{DynamicResource Color.Accent}" />
  </Style>
  <Style Selector="Button.titlebar-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.titlebar-button.close /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Color.CloseHoverTransparent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- Close gets the platform-standard red hover instead of the accent tint every other caption
       button uses — "this ends the app" is a distinct signal from "this is the active section." -->
  <Style Selector="Button.titlebar-button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.titlebar-button.close:pointerover Path.titlebar-icon">
    <Setter Property="Stroke" Value="White" />
  </Style>
  <Style Selector="Button.titlebar-button.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F1707A" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Path.titlebar-icon">
    <Setter Property="Stroke" Value="{DynamicResource Color.TextSecondary}" />
  </Style>

  <!-- A small selectable pill (#211): the Outputs tab's output-file buttons. Radius.Small, not
       .Medium — chips are one step down from a card, per design-language.md's shape table. -->
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
  </Style>
  <Style Selector="Button.chip.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Color.AccentSubtleBg}" />
  </Style>

</Styles>
