<!-- #1318 (decision 0058's scope ruling): the small parametric composite control the ruling asks
     for — overlaid Path children, one per step, via a data-bound repeater. A sibling mechanism to
     the status marks' single StreamGeometry-per-state, not a generalization of StatusIconMap; do not
     fold this into that machinery. One control serves both the three-step depth meter and the
     four-step effort meter — Steps carries whichever family's step list the bound converter built
     (Converters/TierMeterConverters.cs), so this control itself knows nothing about tiers or
     vendors, only how to lay out a list of (geometry, filled) pairs. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aer.Ui.Controls"
             x:Class="Aer.Ui.Controls.TierMeter"
             x:DataType="controls:TierMeter">
  <UserControl.Styles>
    <!-- Achromatic (0058 constraint 1, the same theme-variant-aware pattern
         StatusToIconFillConverter established): a filled step paints Color.TextSecondary; an
         unfilled one keeps only the Stroke outline below. Fill count is the signal, never colour. -->
    <Style Selector="Path.filled">
      <Setter Property="Fill" Value="{DynamicResource Color.TextSecondary}" />
    </Style>
  </UserControl.Styles>
  <!-- Each step's own StreamGeometry is already positioned within one shared 16x16 canvas (see
       Icons.axaml's Icon.DepthStep*/Icon.EffortStep*), so the steps are OVERLAID in one Panel rather
       than spaced apart by a StackPanel — "overlaid" in the ruling's own sense, not a row of icons. -->
  <ItemsControl ItemsSource="{Binding Steps, RelativeSource={RelativeSource AncestorType=controls:TierMeter}}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <Panel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="controls:TierMeterStep">
        <Path Data="{Binding Geometry}" Classes.filled="{Binding IsFilled}"
              Stroke="{DynamicResource Color.TextSecondary}" StrokeThickness="1"
              StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
              Width="16" Height="16" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
