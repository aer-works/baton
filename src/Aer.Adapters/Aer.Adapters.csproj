<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aer.Flow\Aer.Flow.csproj" />
    <!-- M17 Phase 4 (#167): DialogueWorkerAdapter locates and spawns the Aer.Workers.Dialogue
         executable via `dotnet exec <dll>`, not a vendor CLI on PATH; this reference exists purely
         so MSBuild copies its build output next to every consumer of this project (Aer.Cli, Aer.Ui,
         their test hosts), and so `dotnet pack`'s Aer.Cli nupkg (M13) bundles it for free. It carries
         no other coupling: Aer.Workers.Dialogue still references neither Aer.Flow nor Aer.Adapters
         (M17 Phase 2's decision of record), so this edge is one-directional. -->
    <ProjectReference Include="..\Aer.Workers.Dialogue\Aer.Workers.Dialogue.csproj" />

    <!-- #667: AtomicLaunchConfigWriter is internal and had no direct tests, so its drift-correction
         behaviour could only be reached through ClaudeWorkerAdapter.Resolve. That meant a test had
         to hand-write the one shared claude-settings.json, and that is what forced the whole
         Aer.Adapters.Tests suite to be serialised. Testing the writer against a throwaway path
         instead removes the shared state rather than scheduling around it. -->
    <InternalsVisibleTo Include="Aer.Adapters.Tests" />
    <!-- #1319: SaveMetadataAsync is internal (the raw, RMW-unsafe primitive) so Aer.Daemon's endpoint
         code cannot reach it directly; production writes must go through
         InteractiveSessionMaterializer.UpdateMetadataAsync. Aer.Ui.Tests hosts the daemon in-proc for
         its endpoint integration tests and still needs the raw primitive to seed exact fixture state
         (a concern distinct from production RMW safety), which is why it gets this grant and
         Aer.Daemon deliberately does not. -->
    <InternalsVisibleTo Include="Aer.Ui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- #888: the shared worker-role catalog. Copied next to the engine as the shipped default, NOT
         embedded, so an operator can retune tiers at runtime (a worker-tiers.json under AER_HOME, or
         the AER_WORKER_*_PATH env override) with no rebuild. tools/aer-agy-loop/dispatch.py reads the
         same tracked files, so there is one source. -->
    <None Include="WorkerRoles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="WorkerTiers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="WorkflowTemplates.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
