<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Baton\Baton.csproj" />
    <ProjectReference Include="..\Baton.Vendors\Baton.Vendors.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- #107: pack baton as an installable global dotnet tool. No public feed exists to
       collide with, so PackageId/ToolCommandName are a local-convenience choice,
       not a namespace-squatting concern. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>baton</ToolCommandName>
    <PackageId>baton</PackageId>
  </PropertyGroup>

  <!-- No separate native-lib packaging step needed: PackAsTool packs from a *publish* output
       (unlike plain library packing, which only picks up the primary DLL), and publish already
       folds in every referenced project's Content/CopyToOutputDirectory item, including
       Baton.Core.csproj's aer_core copy (M7 Phase 6), landing it at tools/$(TargetFramework)/any/
       next to the managed DLLs for free. Confirmed by inspecting the packed nupkg (#107). -->

</Project>
