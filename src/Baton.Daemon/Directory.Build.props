<Project>

  <!-- release-please linked-versions migration: Baton.Daemon is an independently shipped artifact, so
       it carries the real, release-please-patched Version rather than inheriting the root file's
       static default. (Until #1412 archived it, this Version fed a desktop-spawned-daemon
       respawn-on-skew check — Baton.Ui.Core's RoomClient compared its own version against the
       daemon's own reported /api/version to detect a stale subprocess. Both that comparison and
       the /api/version endpoint itself are gone now — #1420 deleted the daemon's entire HTTP
       surface.) Imports the root file first for shared settings, then overrides just Version. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <Version>0.21.0</Version>
  </PropertyGroup>

</Project>
