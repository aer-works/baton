<Project Sdk="Microsoft.NET.Sdk">

  <!-- M19 Phase 2 (#187): the remote-ready seam, compiler-enforced. Everything presentation-agnostic
       that Aer.Ui accumulated over M14–M18 — the projection loaders/projectors, the ViewModels, and
       the room orchestration extracted from MainWindow code-behind — lives here, with no
       Avalonia reference, so the boundary M14 drew as a decision of record ("presentation-layer,
       deliberately not engine-owned") is now held by the type system rather than discipline.
       Aer.Ui is the Avalonia skin over this project; a future remote host (candidate M20)
       references this project and never Aer.Ui. CommunityToolkit.Mvvm stays the ViewModel stack
       (M15 Phase 2's decision): source-generated and UI-framework-free, it binds equally from
       Avalonia today and any future client. -->
  <ItemGroup>
    <ProjectReference Include="..\Aer.Flow\Aer.Flow.csproj" />
    <ProjectReference Include="..\Aer.Cli\Aer.Cli.csproj" />
    <ProjectReference Include="..\Aer.Adapters\Aer.Adapters.csproj" />
    <ProjectReference Include="..\Aer.RoomSession\Aer.RoomSession.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- M21 Phase 3 (issue #234): pairing QR generation for the Enable Remote Access view.
         PngByteQRCode is a pure-C# PNG writer (no System.Drawing), so this stays consistent with
         Aer.Ui.Core's no-Avalonia, cross-platform (win/linux/mac) constraint above — Aer.Ui's view
         layer turns the resulting bytes into an Avalonia Bitmap. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
