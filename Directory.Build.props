<Project>

  <!-- M13 Phase 2 (#108) set this up as the repo's single shared version; the release-please
       linked-versions migration (the "core" group — Baton/Baton.Vendors/Baton.Cli — see
       release-please-config.json) moved real, release-please-patched versioning onto
       Baton.Cli's own local Directory.Build.props, the sole independently-shipped artifact left
       after #1458 folded Baton.Daemon into it (Baton.Daemon carried its own local
       Directory.Build.props and versioned independently from #1412, when it stopped sharing the
       desktop group with Baton.Ui/Baton.Ui.Core, until #1458 removed both). This root Version is
       now just the static default every other project (Baton, Baton.Vendors) inherits — none of
       them are independently packed/shipped, so nothing reads their own assembly version, and it
       no longer needs to move on its own. -->
  <PropertyGroup>
    <Version>0.14.0</Version>

    <!-- The SDK defaults to appending "+<git-sha>" to AssemblyInformationalVersion, which would make
         `baton`'s version flag output ("0.7.0+<sha>") never match CHANGELOG.md's plain "0.7.0" entry —
         exactly what this phase's produced-artifact requirement rules out. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
