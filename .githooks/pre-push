#!/bin/sh
# Refuse to push a tree the fast gates reject.
#
# Committed and wired through core.hooksPath rather than left in .git/hooks, so it is a property of
# the repository rather than of one clone: it binds whoever pushes, including an agent session.
#
# `gates --fast` is everything but the test suite -- membership lives in tools/gates/gates.py,
# never restated here, and so does why the line is drawn there. CI still runs everything on its one
# (Windows) platform; this only stops the failures that were already knowable here.
#
# Receipt skip (#1636, spec/baton.md C-12 for the why): `gates.py` writes a receipt on every PASS
# and `--check-receipt` is the only place that decides whether it still holds for the tree being
# pushed. The exit code remains the whole contract -- a receipt only ever skips a run that would
# have passed anyway, never suppresses one that would not have.
#
# GIT_* scrubbed here: git exports these to every hook, and a gate whose fixture spawns `git init`
# in a temp dir honours the inherited GIT_DIR over its own path argument -- re-initializing THIS
# repository instead (#1648, spec/baton.md C-12).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

if pixi run gates-check-receipt; then
    exit 0
fi
exec pixi run gates-fast
