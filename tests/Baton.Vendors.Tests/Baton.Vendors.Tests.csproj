<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Generates packages.lock.json so CI can cache NuGet restore (actions/setup-dotnet's
         cache-dependency-path globs **/packages.lock.json, same as Baton.Flow.Tests). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Baton.Vendors\Baton.Vendors.csproj" />
    <!-- #543: ClaudeWorkerAdapterTests spawns the real hook-check executable end to end, which
         needs Baton.Cli's build output copied alongside this test binary. Baton.Vendors itself must
         never reference Baton.Cli (ReferenceDirectionTests enforces that against the src/ project,
         not this one); this is a test-only dependency to exercise the real artifact, the same
         reason a test project routinely needs more than its production project under test does. -->
    <ProjectReference Include="..\..\src\Baton.Cli\Baton.Cli.csproj" />
  </ItemGroup>

</Project>
