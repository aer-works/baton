<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure-helper tests only. This project NEVER invokes a vendor CLI (no Cli.Invoke), so it is
         safe in CI where no vendor is authenticated; the live probe run stays `pixi run vendor-probe`,
         human and paid, exactly like the smoke tests. -->
    <ProjectReference Include="..\..\tools\Aer.VendorProbe\Aer.VendorProbe.csproj" />
  </ItemGroup>

</Project>
