<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Generates packages.lock.json so CI can cache NuGet restore (actions/setup-dotnet's
         cache-dependency-path globs **/packages.lock.json, same as the other test projects). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- M19 Phase 2 (#187): the moved presentation-agnostic types (projections, ViewModels) live in
         the Aer.Ui.Core namespace now; a global using keeps every existing test's bare type names
         resolving exactly as they did when the types sat in Aer.Ui. -->
    <Using Include="Aer.Ui.Core" />
    <!-- #1412: the room read-model moved again, into Aer.RoomSession. Aliased per type rather than
         a second namespace-wide using because BOTH namespaces now declare a RoomClient (the daemon's
         extracted one and the desktop's original) and this suite has ~80 bare RoomClient references
         that must keep meaning Aer.Ui.Core.RoomClient until the Ui archive deletes it. -->
    <Using Include="Aer.RoomSession.RoomProjection" Alias="RoomProjection" />
    <Using Include="Aer.RoomSession.RoomProjectionLoader" Alias="RoomProjectionLoader" />
    <Using Include="Aer.RoomSession.RoomFleetItem" Alias="RoomFleetItem" />
    <Using Include="Aer.RoomSession.ExecutionHistory" Alias="ExecutionHistory" />
    <Using Include="Aer.RoomSession.ExecutionAttempt" Alias="ExecutionAttempt" />
    <Using Include="Aer.RoomSession.DecisionRecord" Alias="DecisionRecord" />
    <Using Include="Aer.RoomSession.ExecutionHistoryProjector" Alias="ExecutionHistoryProjector" />
    <Using Include="Aer.RoomSession.ArtifactLineage" Alias="ArtifactLineage" />
    <Using Include="Aer.RoomSession.ExecutionArtifacts" Alias="ExecutionArtifacts" />
    <Using Include="Aer.RoomSession.ArtifactInputLink" Alias="ArtifactInputLink" />
    <Using Include="Aer.RoomSession.ArtifactLineageProjector" Alias="ArtifactLineageProjector" />
    <Using Include="Aer.RoomSession.RoomFiles" Alias="RoomFiles" />
    <Using Include="Aer.RoomSession.RoomFile" Alias="RoomFile" />
    <Using Include="Aer.RoomSession.FileVersion" Alias="FileVersion" />
    <Using Include="Aer.RoomSession.RoomFilesProjector" Alias="RoomFilesProjector" />
    <Using Include="Aer.RoomSession.InvalidRoomDirectoryException" Alias="InvalidRoomDirectoryException" />
    <Using Include="Aer.RoomSession.LocalUiConfigurationStore" Alias="LocalUiConfigurationStore" />
    <Using Include="Aer.RoomSession.RoomCardStatus" Alias="RoomCardStatus" />
    <Using Include="Aer.RoomSession.RoomCardViewModel" Alias="RoomCardViewModel" />
    <Using Include="Aer.RoomSession.BindingsPathHolder" Alias="BindingsPathHolder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aer.Ui.Core\Aer.Ui.Core.csproj" />
    <ProjectReference Include="..\..\src\Aer.Ui\Aer.Ui.csproj" />
    <ProjectReference Include="..\..\src\Aer.Flow\Aer.Flow.csproj" />
    <!-- M15 Phase 1 (#137): MainWindow.RunAsync goes through the real RunCommand/IWorkerAdapter
         seam, not a hand-built WorkerBinding, so tests need both directly. -->
    <ProjectReference Include="..\..\src\Aer.Cli\Aer.Cli.csproj" />
    <ProjectReference Include="..\..\src\Aer.Adapters\Aer.Adapters.csproj" />
    <ProjectReference Include="..\..\src\Aer.Daemon\Aer.Daemon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded through the same real Aer.Flow read-model calls Aer.Ui.RoomProjectionLoader uses,
         from a fixture file on disk rather than an in-memory WorkflowDefinition (matches
         Aer.Flow.Tests.EndToEnd.WorkflowEndToEndTests' convention, issue #14). -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
